{
  "name": "trotroos",
  "version": "1.4.0",
  "description": "Real-time trotro app for Kumasi, Ghana — passengers find rides, mates broadcast trips.",
  "main": "index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Mensah-u/TrotroOS.git"
  },
  "author": "Mensah-u",
  "license": "UNLICENSED",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -ForceRestart",
    "start:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Tunnel",
    "fix:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-firewall.ps1",
    "start:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -ForceRestart -ClearCache",
    "qr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/show-qr.ps1",
    "start:lan": "expo start",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/post-web-build.js",
    "preview:web": "npx serve dist",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:store-assets": "node scripts/generate-store-assets.js",
    "precheck:release": "npm run generate:store-assets",
    "check:release": "node scripts/check-release.js",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:apk:eas": "eas build --platform android --profile preview --non-interactive",
    "setup:eas-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-eas-env.ps1",
    "get:sha1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/get-android-sha1.ps1",
    "build:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-aab.ps1",
    "deploy:paystack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-paystack-functions.ps1",
    "debug:supabase": "node scripts/debug-supabase-rls.js",
    "build:complete-sql": "node scripts/build-complete-sql.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.16.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "sharp": "^0.34.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
